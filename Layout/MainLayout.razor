@inherits LayoutComponentBase
@inject ThemeService ThemeService
@inject NavigationManager Navigation
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <button type="button"
                    class="btn btn-link theme-toggle"
                    title="Alternar tema"
                    @onclick="ToggleThemeAsync">
                @if (ThemeService.IsDark)
                {
                    <i class="bi bi-sun-fill"></i>
                }
                else
                {
                    <i class="bi bi-moon-stars-fill"></i>
                }
            </button>

            <a href="https://github.com/BotterPedro/TodoApi" target="_blank" rel="noopener">
                <i class="bi bi-github"></i> GitHub
            </a>
            <a href="https://todoapi-lhrs.onrender.com/swagger" target="_blank" rel="noopener" class="ms-3">
                <i class="bi bi-code-slash"></i> API
            </a>
        </div>

        <article class="content px-4 py-3" @key="_paginaAtual">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Ocorreu um erro.
    <a href="" class="reload">Recarregar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string? _paginaAtual;

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnChange += AtualizarEstado;
        await ThemeService.InitializeAsync();
        _paginaAtual = Navigation.Uri;
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeService.ToggleAsync();
    }

    private void AtualizarEstado()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        ThemeService.OnChange -= AtualizarEstado;
    }
}