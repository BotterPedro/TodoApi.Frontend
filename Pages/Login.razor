@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Entrar - TodoApi</PageTitle>

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="card-title mb-4 text-center">Entrar</h2>

                @if (!string.IsNullOrWhiteSpace(_erro))
                {
                    <div class="alert alert-danger">@_erro</div>
                }

                <EditForm Model="_model" OnValidSubmit="FazerLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">E-mail</label>
                        <InputText @bind-Value="_model.Email" class="form-control" type="email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Senha</label>
                        <InputText @bind-Value="_model.Senha" class="form-control" type="password" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100" disabled="@_carregando">
                        @if (_carregando)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Entrar
                    </button>
                </EditForm>

                <div class="text-center mt-3">
                    <span>Não tem conta? </span>
                    <a href="/cadastro">Cadastre-se</a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginDto _model = new();
    private string? _erro;
    private bool _carregando;

    private async Task FazerLogin()
    {
        _erro = null;
        _carregando = true;

        try
        {
            var resultado = await AuthService.LoginAsync(_model);

            if (resultado is null)
            {
                _erro = "E-mail ou senha inválidos.";
                return;
            }

            Navigation.NavigateTo("/tarefas");
        }
        catch (Exception ex)
        {
            _erro = $"Erro ao entrar: {ex.Message}";
        }
        finally
        {
            _carregando = false;
        }
    }
}